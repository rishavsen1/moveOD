# Environment variables for MOVE-OD
# Copy this file to .env and fill in your Census API key

# Get your free Census API key from: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=YOUR_CENSUS_API_KEY_HERE

# CTPP data API key, needed only for analysis/ctpp.py and the opt-in --ctpp-anchor
CTPP_API_KEY=YOUR_CTPP_API_KEY_HERE
